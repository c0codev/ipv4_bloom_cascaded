use bloomfilter::Bloom;

pub struct ThirdPartyBloom {
    inner: Bloom<u32>,
}

impl ThirdPartyBloom {
    pub fn new(expected_items: usize, target_fp_rate: f64) -> Self {
        let bloom = Bloom::new_for_fp_rate(expected_items, target_fp_rate).expect("Critical Error: Couldn't initialize the struct (Possibly due to internal hash collisions)");
        let bytes = Bloom::<[u8]>::compute_bitmap_size(expected_items, target_fp_rate);
        let m_bits = (bytes as u64) * 8;
        let mib = bytes as f64 / 1024.0 / 1024.0;
        eprintln!("DEBUG: Bloom uses {} bits ({:.2} MiB) for n={}, p={}", m_bits, mib, expected_items, target_fp_rate);
        Self { inner: bloom }
    }

    #[inline(always)]
    pub fn batch_processing(&mut self, ips: [u32; 8]) -> [u32; 8] {
        let mut results = [0u32; 8];
        for i in 0..8 {
            results[i] = if self.inner.check(&ips[i]) { 0 } else { 1 };
        }
        results
    }

    pub fn inject_ban(&mut self, ip: u32) {
        self.inner.set(&ip);
    }
}
